# Copier en .env et remplir. Ne jamais versionner le fichier .env.

# Mot de passe de la base de données (générer : openssl rand -hex 24)
POSTGRES_PASSWORD=

# Secret de l'application, 32 caractères minimum (générer : openssl rand -hex 32).
# Il sert aussi à hacher les flags : le changer impose de resynchroniser le pack.
JACQUARD_SECRET_KEY=

# Code exigé à l'inscription si le pack déclare `registration: invite_code`.
JACQUARD_REGISTRATION_CODE=

# Domaine public pour le certificat TLS automatique, ou :80 en local.
JACQUARD_DOMAIN=:80

# Mettre false uniquement en local, sans HTTPS.
JACQUARD_COOKIE_SECURE=true

# Chemin vers le pack de l'événement (clone du repo privé).
JACQUARD_PACK_DIR=./examples/demo-pack
